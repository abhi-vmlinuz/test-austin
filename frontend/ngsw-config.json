{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "resources": {
        "files": [
          "/index.html",
          "/manifest.webmanifest",
          "/*.css",
          "/*.js",
          "/assets/icon-*.png",
          "/assets/login-side.png"
        ]
      }
    },
    {
      "name": "assets",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/assets/**",
          "!/assets/hero.mp4",
          "/*.(svg|cur|jpg|jpeg|gif|png|webp|ico|woff|woff2)"
        ]
      }
    }
  ],
  "dataGroups": [
    {
      "name": "video-network-first",
      "urls": ["/assets/hero.mp4"],
      "cacheConfig": {
        "strategy": "freshness",
        "maxSize": 1,
        "maxAge": "1h",
        "timeout": "3s"
      }
    }
  ]
}
